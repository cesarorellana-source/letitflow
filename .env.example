# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local al repositorio.

# Nombre provisional del producto (configurable).
NEXT_PUBLIC_APP_NAME=LetItFlow

# URL pública de la app (opcional en local; recomendada en producción).
NEXT_PUBLIC_SITE_URL=

# Supabase (Settings > API en tu proyecto). La URL y la clave anon son públicas por diseño;
# la protección de los datos la dan las políticas RLS de supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Salta la RLS: nunca la expongas al navegador ni la pegues en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Proveedor de IA: "claude" o "fake" (respuestas de prueba, sin costo ni red).
AI_PROVIDER=fake
ANTHROPIC_API_KEY=
AI_MODEL_DEFAULT=claude-sonnet-5-5
# Tope mensual de costo estimado por espacio de trabajo (USD).
AI_MONTHLY_BUDGET_USD=5
# Precios del modelo en USD por millón de tokens. Cópialos de la página de precios del
# proveedor; sin ellos el adaptador de Claude no funciona (no se estima ni limita el costo).
AI_PRICE_INPUT_PER_MTOK_USD=
AI_PRICE_OUTPUT_PER_MTOK_USD=
